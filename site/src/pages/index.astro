---
import Wordmark from '../components/Wordmark.astro';
import '../styles/landing.css';
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>tsk — a task board for your terminal</title>
    <meta
      name="description"
      content="tsk captures work and moves it through human status: ready, started, blocked, review, done. A queue board for your terminal."
    />
    <script is:inline>
      (function () {
        var k = 'tsk-theme';
        var t = null;
        try {
          t = localStorage.getItem(k) || localStorage.getItem('starlight-theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = 'dark';
        document.documentElement.dataset.theme = t;
        document.documentElement.style.colorScheme = t;
        try {
          localStorage.setItem(k, t);
          localStorage.setItem('starlight-theme', t);
        } catch (e) {}
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/icon-dark.svg" type="image/svg+xml" />
    <link
      rel="icon"
      href="/icon-dark.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href="/icon-light.svg"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon-dark.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon-light.png"
      media="(prefers-color-scheme: light)"
    />
  </head>
  <body class="landing">
    <div class="grain" aria-hidden="true"></div>

    <header class="top">
      <a class="mark" href="/" aria-label="tsk"><Wordmark /></a>
      <nav class="top-nav" aria-label="Primary">
        <a href="#board">Board</a>
        <a href="/docs/">Docs</a>
        <a href="#install">Install</a>
        <a
          class="top-github"
          href="https://github.com/smarzban/herdr-tsk"
          rel="noopener noreferrer"
          >GitHub</a
        >
        <button
          type="button"
          class="theme-toggle"
          data-theme-toggle
          aria-label="Switch to light mode"
          aria-pressed="true"
        >
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
        </button>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="brand">
        <div class="hero-copy">
          <p class="brand" id="brand">tsk</p>
          <div class="hero-text">
            <h1 class="headline">A task board for your terminal.</h1>
            <p class="lede">
              Capture work. Move it through ready, started, blocked, review, and
              done. The board below is a live demo — same keys as the app.
            </p>
            <div class="cta">
              <a class="btn btn-primary" href="#install">Install</a>
              <a class="btn btn-ghost" href="/docs/">Read the docs</a>
            </div>
          </div>
        </div>

        <div class="hero-stage" id="board" aria-label="tsk board demo">
          <div class="terminal-motion">
            <div
              class="terminal"
              id="board-demo"
              tabindex="0"
              role="application"
              aria-label="tsk board demo"
            >
              <div class="terminal-chrome">
                <span class="terminal-dots" aria-hidden="true"></span>
                <span class="terminal-title">tsk · demo</span>
                <span class="demo-hint dim">click to focus · + capture · ? help</span>
              </div>
              <div class="board tsk-demo" id="tsk-demo"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="band status-band" id="status" aria-labelledby="status-heading">
        <div class="band-inner">
          <h2 id="status-heading">Human status is the source of truth.</h2>
          <p class="band-lede">
            Agents do not auto-complete your work. You move tasks with verbs.
            Mutating keys need Alt, so typing into a focused board cannot finish
            or delete anything by accident.
          </p>
          <ol class="status-rail" aria-label="Task statuses">
            <li><span class="status-name">ready</span><span class="status-hint">on deck</span></li>
            <li><span class="status-name">started</span><span class="status-hint">in motion</span></li>
            <li><span class="status-name">blocked</span><span class="status-hint">waiting</span></li>
            <li><span class="status-name">review</span><span class="status-hint">check it</span></li>
            <li><span class="status-name">done</span><span class="status-hint">drawer</span></li>
          </ol>
        </div>
      </section>

      <section class="band capture-band" aria-labelledby="capture-heading">
        <div class="band-inner capture-grid">
          <div>
            <h2 id="capture-heading">Capture stays on the board.</h2>
            <p class="band-lede">
              Press <kbd>+</kbd> for a one-line title. Enter saves. Tab expands
              onto the task page for notes and scope. Tokens in the title set
              project and thread without leaving the line.
            </p>
          </div>
          <ul class="token-list">
            <li>
              <code>!p</code>
              <span>desk</span>
            </li>
            <li>
              <code>!p name</code>
              <span>project by basename</span>
            </li>
            <li>
              <code>!t name</code>
              <span>thread, normalized</span>
            </li>
            <li>
              <code>!t</code>
              <span>unthread</span>
            </li>
          </ul>
        </div>
      </section>

      <section class="band install-band" id="install" aria-labelledby="install-heading">
        <div class="band-inner">
          <h2 id="install-heading">Build it, then open the board.</h2>
          <div class="install-block">
            <pre class="shell"><span class="shell-prompt">$</span> git clone git@github.com:smarzban/herdr-tsk.git
<span class="shell-prompt">$</span> cd herdr-tsk
<span class="shell-prompt">$</span> cargo build --release
<span class="shell-prompt">$</span> ./target/release/tsk</pre>
            <p class="install-note">
              Plugin mode: <code>herdr plugin link "$PWD"</code>, then Open tsk
              board. State lives in <code>~/.tsk</code> either way. Full steps in
              the <a href="/docs/install/">install guide</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-foot">
      <p>
        <span class="mark">tsk</span>
        <span class="foot-sep">·</span>
        a task board for your terminal
      </p>
      <p>
        <a href="/docs/">docs</a>
        <span class="foot-sep">·</span>
        <a href="https://github.com/smarzban/herdr-tsk" rel="noopener noreferrer"
          >github.com/smarzban/herdr-tsk</a
        >
      </p>
    </footer>

    <script is:inline src="/theme.js"></script>
    <script is:inline src="/landing.js"></script>
    <script is:inline src="/board-demo.js"></script>
  </body>
</html>
