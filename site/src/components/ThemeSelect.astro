---
/**
 * Replaces Starlight's theme control with the same animated toggle
 * used on the landing page. Dark is the default (see theme-init).
 */
---

<button
  type="button"
  class="tsk-theme-toggle"
  data-theme-toggle
  aria-label="Switch to light mode"
  aria-pressed="true"
>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
  </svg>
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<style>
  .tsk-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
    margin: 0;
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }

  .tsk-theme-toggle:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }

  .tsk-theme-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tsk-theme-toggle .icon-sun {
    display: none;
  }

  :global([data-theme='light']) .tsk-theme-toggle .icon-sun {
    display: block;
  }

  :global([data-theme='light']) .tsk-theme-toggle .icon-moon {
    display: none;
  }

  :global([data-theme='light']) .tsk-theme-toggle {
    color: var(--sl-color-gray-2);
  }
</style>

<script is:inline src="/theme.js"></script>
